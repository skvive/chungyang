# 127.0.0.1 default: private computer only; reverse proxy HTTPS for public hosting.
CYPLUS_HOST=127.0.0.1
CYPLUS_PORT=8787
# CYPLUS_DATABASE=./data/cheongyangplus.db
# DATABASE_URL=postgresql://...  (Neon — production)
# NEON_AUTH_URL=https://....neon.tech/neondb/auth
# CYPLUS_SESSION_SECRET=generate-at-least-32-random-bytes
# CYPLUS_PUBLIC_URL=https://example.com
# Google Blogger (optional; default is create draft only)
# BLOGGER_BLOG_ID=
# BLOGGER_CLIENT_ID=
# BLOGGER_CLIENT_SECRET=
# BLOGGER_REFRESH_TOKEN=
# alternatively short-lived BLOGGER_ACCESS_TOKEN= (local tests only)

# Local setup registration only by default. Avoid enabling remote setup in production.
# CYPLUS_ALLOW_REMOTE_SETUP=0
# When behind trusted HTTPS reverse proxy: set both 1 and public https URL.
# CYPLUS_SECURE_COOKIE=1
